  "license": "MIT",
  "author": "Yht20927",
  "main": "cli.js",
  "bin": {
    "ths": "./cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "server": "node server.js",
    "bridge": "scripts/bridge.sh",
